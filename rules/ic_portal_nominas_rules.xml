<!--
  Reglas propias del portal de nóminas.
  Los identificadores de 100000 a 120000 están reservados para reglas de usuario.
-->
<group name="local,portal_nominas,">

  <rule id="100104" level="0">
    <decoded_as>portal-nominas</decoded_as>
    <description>Portal de nóminas: evento.</description>
  </rule>

  <rule id="100101" level="5">
    <if_sid>100104</if_sid>
    <field name="accion">^login_fail$</field>
    <description>Portal de nóminas: acceso fallido de $(dstuser) desde $(srcip).</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100102" level="3">
    <if_sid>100104</if_sid>
    <field name="accion">^login_ok$</field>
    <description>Portal de nóminas: acceso correcto de $(dstuser) desde $(srcip).</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="100103" level="3">
    <if_sid>100104</if_sid>
    <field name="accion">^export$</field>
    <description>Portal de nóminas: $(dstuser) exportó $(registros) registros desde $(srcip).</description>
  </rule>

  <rule id="100110" level="10" frequency="5" timeframe="120">
    <if_sid>100101</if_sid>
    <if_matched_sid>100101</if_matched_sid>
    <same_srcip />
    <description>Portal de nóminas: cinco accesos fallidos desde $(srcip) en dos minutos.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <rule id="100111" level="12" frequency="2" timeframe="600">
    <if_sid>100102</if_sid>
    <if_matched_sid>100110</if_matched_sid>
    <same_srcip />
    <description>Portal de nóminas: acceso correcto de $(dstuser) desde $(srcip) tras una ráfaga de fallos.</description>
  </rule>

  <rule id="100112" level="10">
    <if_sid>100103</if_sid>
    <srcip negate="yes">10.20.0.0/24</srcip>
    <description>Portal de nóminas: $(dstuser) exportó $(registros) registros desde la IP externa $(srcip).</description>
  </rule>

</group>
