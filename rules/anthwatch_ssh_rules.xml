<group name="local,sshd,anthwatch,">
  <rule id="100100" level="10" frequency="4" timeframe="120">
    <if_sid>5715</if_sid>
    <if_matched_sid>5760</if_matched_sid>
    <same_srcip />
    <same_user />
    <description>Anthwatch: acceso SSH correcto tras varios fallos para $(dstuser) desde $(srcip).</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>
</group>
